{
  "name": "stellar-atlas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"vite\" \"npm run serve:api\"",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "npm run serve:api",
    "start": "npm run serve:api",
    "serve:api": "node --env-file-if-exists=.env --import tsx server/main.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "review:api-security": "node scripts/review-api-security.mjs",
    "check": "npm test && npm run lint && npm run build && npm run review:api-security"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.1",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "concurrently": "^9.2.1",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "tsx": "^4.20.6",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  },
  "dependencies": {
    "three": "^0.186.1",
    "vue": "^3.5.43"
  }
}
